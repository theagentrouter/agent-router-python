+	flags, err := parseAndValidateFlags([]string{"-configBundlePath", "/path/to/config-bundle"})
+	require.NoError(t, err)
+	require.Empty(t, flags.adminAddr) // the admin server keeps listening on :adminPort
+	flags, err = parseAndValidateFlags([]string{"-configBundlePath", "/path/to/config-bundle", "-adminAddr", "127.0.0.1:1064"})
