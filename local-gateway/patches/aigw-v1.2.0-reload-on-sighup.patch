+// extProcReloadWait is how long a reload waits for the external processor to load its new configuration before
+// Envoy Gateway is given the new routes: the external processor checks its configuration every five seconds.
+var extProcReloadWait = 6 * time.Second
+
+// reload translates the configuration file again and hands the result to the running gateway: the extension server
+// reads the new objects, the external processor loads its new configuration, and then Envoy Gateway, which watches
+// its resources directory, updates Envoy. Envoy keeps running, so requests in flight are not dropped. Values that
+// come from the aigw process environment cannot change without a restart; values read from files can.
+func (runCtx *runCmdContext) reload(ctx context.Context, c *cmdRun, o *runOpts, extClient *reloadableClient, listenerPort int) error {
+	original, err := readConfig(o.configPath, c.mcpConfig, c.Debug)
+	if err != nil {
+		return err
+	}
+	resources := &bytes.Buffer{}
+	previous := runCtx.envoyGatewayResourcesOut
+	runCtx.envoyGatewayResourcesOut = resources
+	defer func() { runCtx.envoyGatewayResourcesOut = previous }()
+	fakeClient, fc, port, err := runCtx.writeEnvoyResources(ctx, original)
+	if err != nil {
+		return err
+	}
+	if port != listenerPort {
+		return fmt.Errorf("the listener port cannot change without a restart: %d to %d", listenerPort, port)
+	}
+	marshaled, err := yaml.Marshal(fc)
+	if err != nil {
+		return fmt.Errorf("failed to marshal filter config: %w", err)
+	}
+	extClient.set(fakeClient)
+	if err = writeExtProcConfigBundle(filepath.Join(runCtx.tmpdir, "extproc-config-bundle"), marshaled); err != nil {
+		return fmt.Errorf("failed to write extension proc config bundle: %w", err)
+	}
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-time.After(extProcReloadWait):
+	}
+	// Write a new file and rename it into place, so Envoy Gateway never reads a partial file. The new file is written
+	// outside the directory Envoy Gateway watches: it loads every file there, and stops when one disappears.
+	partial := filepath.Join(filepath.Dir(filepath.Dir(o.egResourcesPath)), "envoy-ai-gateway-resources.reload")
+	if err = os.WriteFile(partial, resources.Bytes(), 0o600); err != nil {
+		return fmt.Errorf("failed to write file %s: %w", partial, err)
+	}
+	return os.Rename(partial, o.egResourcesPath)
+}
+
+// reloadableClient is the client the extension server reads objects through. A reload replaces the client behind
+// it; the extension server only gets and lists objects.
+type reloadableClient struct {
+	client.Client
+	current atomic.Pointer[client.Client]
+}
+
+func newReloadableClient(c client.Client) *reloadableClient {
+	r := &reloadableClient{Client: c}
+	r.current.Store(&c)
+	return r
+}
+
+func (r *reloadableClient) set(c client.Client) { r.current.Store(&c) }
+
+// Get implements [client.Reader].
+func (r *reloadableClient) Get(ctx context.Context, key client.ObjectKey, obj client.Object, opts ...client.GetOption) error {
+	return (*r.current.Load()).Get(ctx, key, obj, opts...)
+}
+
+// List implements [client.Reader].
+func (r *reloadableClient) List(ctx context.Context, list client.ObjectList, opts ...client.ListOption) error {
+	return (*r.current.Load()).List(ctx, list, opts...)
 }
 
