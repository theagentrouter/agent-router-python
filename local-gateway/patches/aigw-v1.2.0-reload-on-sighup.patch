+func TestRunCmdContextReloadReplacesTheConfiguration(t *testing.T) {
+	internaltesting.ClearTestEnv(t)
+	t.Setenv("OPENAI_BASE_URL", "http://localhost:11434/v1")
+	t.Setenv("OPENAI_API_KEY", "unused")
+	wait := extProcReloadWait
+	extProcReloadWait = 0
+	t.Cleanup(func() { extProcReloadWait = wait })
+	tmpdir := t.TempDir()
+	runCtx := &runCmdContext{
+		envoyGatewayResourcesOut: &bytes.Buffer{},
+		stderrLogger:             slog.New(slog.DiscardHandler),
+		stderr:                   io.Discard,
+		tmpdir:                   tmpdir,
+		extProcLauncher: func(ctx context.Context, _ []string, _ io.Writer) error {
+			<-ctx.Done()
+			return nil
+		},
+	}
+	original := readFileFromProjectRoot(t, "examples/aigw/ollama.yaml")
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	fakeClient, done, listenerPort, err := runCtx.writeEnvoyResourcesAndRunExtProc(ctx, original)
+	require.NoError(t, err)
+	extClient := newReloadableClient(fakeClient)
+
+	o := &runOpts{configPath: filepath.Join(tmpdir, "config.yaml"), egResourcesPath: filepath.Join(tmpdir, "resources", "config.yaml")}
+	require.NoError(t, os.MkdirAll(filepath.Dir(o.egResourcesPath), 0o700))
+	require.NoError(t, os.WriteFile(o.configPath, []byte(strings.ReplaceAll(original, "name: aigw-run", "name: acme-reloaded")), 0o600))
+	require.NoError(t, runCtx.reload(ctx, &cmdRun{}, o, extClient, listenerPort))
+
+	resources, err := os.ReadFile(o.egResourcesPath)
+	require.NoError(t, err)
+	require.Contains(t, string(resources), "name: acme-reloaded")
+	entries, err := os.ReadDir(filepath.Dir(o.egResourcesPath))
+	require.NoError(t, err)
+	require.Len(t, entries, 1) // nothing else ever appears in the directory Envoy Gateway watches
+	var route aigv1b1.AIGatewayRoute
+	require.NoError(t, extClient.Get(ctx, client.ObjectKey{Namespace: "default", Name: "acme-reloaded"}, &route))
+	require.Error(t, extClient.Get(ctx, client.ObjectKey{Namespace: "default", Name: "aigw-run"}, &route))
+
+	// The listener port cannot move without a restart.
+	require.ErrorContains(t, runCtx.reload(ctx, &cmdRun{}, o, extClient, listenerPort+1), "listener port")
+	cancel()
+	require.NoError(t, <-done)
+}
